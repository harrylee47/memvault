# ============================================
# MemVault Environment Configuration
# ============================================

# --- General ---
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=memvault
POSTGRES_USER=memvault
POSTGRES_PASSWORD=memvault_secret

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8765
API_URL=http://api:8765

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8765
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-nextauth-secret

# --- LLM (mem0 默认配置) ---
OPENAI_API_KEY=sk-xxx
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=text-embedding-3-small

# --- OAuth (可选) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
