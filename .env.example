# ============================================
# MemVault Environment Configuration
# ============================================

# --- General ---
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=memvault
POSTGRES_USER=memvault
POSTGRES_PASSWORD=memvault_secret
# Docker host port (avoid conflicts with local services)
POSTGRES_PORT_HOST=5434

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_PORT_HOST=6381

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_PORT_HOST=6335
QDRANT_GRPC_PORT_HOST=6336

# --- Neo4j (可选，图存储) ---
# 取消注释并在 docker-compose.yml 中启用 neo4j 服务
# NEO4J_URL=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8765

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8765
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me-to-a-random-nextauth-secret
WEB_PORT=3001

# --- LLM (mem0 默认配置) ---
OPENAI_API_KEY=sk-xxx
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=text-embedding-3-small

# --- OAuth (可选) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3001
